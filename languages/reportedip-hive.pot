msgid "Block PHP execution in uploads"
msgstr ""

#: includes/class-settings-registry.php:847
msgid "Refuse to run PHP inside the uploads folder, so a file that got in through an upload form cannot be executed. Written into the uploads .htaccess on Apache; other servers get a snippet to paste."
msgstr ""

#: includes/class-settings-registry.php:853
msgid "Hide software fingerprints"
msgstr ""

#: includes/class-settings-registry.php:854
msgid "Remove the version numbers WordPress prints into your pages. It does not fix anything, it just stops handing a scanner the list of what to try."
msgstr ""

#: includes/class-settings-registry.php:860
msgid "Send security headers"
msgstr ""

#: includes/class-settings-registry.php:861
msgid "Send hardening response headers on every front-end request. A header your server already sets is left alone."
msgstr ""

#: includes/class-settings-registry.php:867
msgid "X-Content-Type-Options"
msgstr ""

#: includes/class-settings-registry.php:868
