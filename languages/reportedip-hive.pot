msgstr ""

#: includes/class-settings-registry.php:518
msgid "Record every decision without acting on any of it. Use this to see what the settings would do before letting them do it."
msgstr ""

#: includes/class-settings-registry.php:526
msgid "Refuse addresses on the signed Tor exit-node list. Anonymity is not an attack in itself, so this is off unless your site has a reason."
msgstr ""

#: includes/class-settings-registry.php:532
msgid "Contact URL on the block page"
msgstr ""

#: includes/class-settings-registry.php:533
msgid "Where a wrongly blocked visitor can reach you. Without it the block page is a dead end for a customer."
msgstr ""

#: includes/class-settings-registry.php:541
msgid "Firewall enabled"
msgstr ""

#: includes/class-settings-registry.php:542
msgid "Inspect every front-end request against attack signatures before it reaches your site."
msgstr ""

#: includes/class-settings-registry.php:548
msgid "Firewall report-only"
msgstr ""

#: includes/class-settings-registry.php:549
msgid "Record what the firewall would have blocked without blocking anything. The right way to try a new rule set on a live site."
msgstr ""

#: includes/class-settings-registry.php:560
msgid "Firewall paranoia level"
msgstr ""

#: includes/class-settings-registry.php:561
msgid "How aggressively the rules are read. Level 1 is the false-positive-poor baseline; higher levels catch obfuscated attacks and need a report-only run first. Level 2 runs from Contributor, Level 3 from Professional."
msgstr ""

#: includes/class-settings-registry.php:569
msgid "Firewall block threshold (hits)"
msgstr ""

#: includes/class-settings-registry.php:570
msgid "How many rule hits one request may collect before it is refused."
msgstr ""

#: includes/class-settings-registry.php:576
msgid "Skip body inspection for signed-in users (Extended Protection)"
msgstr ""

#: includes/class-settings-registry.php:577
msgid "The pre-WordPress guard cannot see roles, only the sign-in cookie. With this on it leaves the request body of signed-in users alone, so an editor saving a post with a script tag in it is not refused before WordPress loads. URL and user-agent rules still run."
msgstr ""

#: includes/class-settings-registry.php:584
msgid "Fetch fresh signatures from the community server. Turned off, the bundled baseline keeps working but stops learning."
msgstr ""

#: includes/class-settings-registry.php:590
msgid "Bot verification"
msgstr ""

#: includes/class-settings-registry.php:591
msgid "Check whether a request that claims to be a known crawler really comes from it. Attackers use the Googlebot name to slip past rate limits."
msgstr ""

#: includes/class-settings-registry.php:599
msgid "Action on failed bot verification"
msgstr ""

#: includes/class-settings-registry.php:600
msgid "What happens to a request whose crawler identity does not hold up."
msgstr ""

#: includes/class-settings-registry.php:608
msgid "Action on disposable email domains"
msgstr ""

#: includes/class-settings-registry.php:609
msgid "What happens when a registration uses a throwaway mail domain."
msgstr ""

#: includes/class-settings-registry.php:615
msgid "Block privacy relay addresses"
msgstr ""

#: includes/class-settings-registry.php:616
msgid "Also reject forwarding services such as Apple and Firefox Relay. These are used by ordinary customers too, so weigh this against your sign-up numbers."
msgstr ""

#: includes/class-settings-registry.php:623
msgid "Prohibited usernames"
msgstr ""

#: includes/class-settings-registry.php:624
msgid "Names that may not be registered, one per line. An entry matches literally, as a wildcard when it contains an asterisk, or as a regular expression when written between slashes."
msgstr ""

#: includes/class-settings-registry.php:630
msgid "Built-in prohibited usernames"
msgstr ""

#: includes/class-settings-registry.php:631
msgid "Also reject the built-in list of role names such as admin, administrator and root. It does not count towards the free entry allowance."
msgstr ""

#: includes/class-settings-registry.php:638
msgid "E-mail rule mode"
msgstr ""

#: includes/class-settings-registry.php:639
msgid "Whether the list below rejects matching addresses, accepts only matching addresses, or is ignored."
msgstr ""

#: includes/class-settings-registry.php:646
msgid "E-mail rules"
msgstr ""

#: includes/class-settings-registry.php:647
msgid "Address patterns, one per line. A bare host name is read as every address at that host."
msgstr ""

#: includes/class-settings-registry.php:653
msgid "Registration rate limit"
msgstr ""

#: includes/class-settings-registry.php:654
msgid "Limit how many accounts one address may create in a row."
msgstr ""

#: includes/class-settings-registry.php:662
msgid "Registrations per window"
msgstr ""

#: includes/class-settings-registry.php:663
msgid "How many sign-ups one address may complete inside the window below."
msgstr ""

#: includes/class-settings-registry.php:671
msgid "Registration window (minutes)"
msgstr ""

#: includes/class-settings-registry.php:672
msgid "The window sign-ups are counted in."
msgstr ""

#: includes/class-settings-registry.php:678
msgid "Block logins with unknown usernames"
msgstr ""

#: includes/class-settings-registry.php:679
msgid "Treat a sign-in attempt for a name that does not exist as an attack straight away. Effective against name guessing, but it also catches a colleague who mistypes their login."
msgstr ""

#: includes/class-settings-registry.php:686
msgid "Comment honeypot"
msgstr ""

#: includes/class-settings-registry.php:687
msgid "Add a field to the comment form that a person never fills in and a bot always does."
msgstr ""

#: includes/class-settings-registry.php:695
msgid "Form execution proof"
msgstr ""

#: includes/class-settings-registry.php:696
msgid "Check whether a comment, sign-up or password reset came from a browser that actually rendered the form, instead of from a script posting straight at the address."
msgstr ""

#: includes/class-settings-registry.php:702
msgid "Apply the proof to sign-up and password reset"
msgstr ""

#: includes/class-settings-registry.php:703
msgid "A comment that fails the check is filed for review, a sign-up or password reset that fails is refused. Switch this off to keep the comment protection while leaving both login forms untouched."
msgstr ""

#: includes/class-settings-registry.php:711
msgid "Protect Contact Form 7 forms"
msgstr ""

#: includes/class-settings-registry.php:712
msgid "Put the same check on every Contact Form 7 form: the entry has to come from a browser that rendered the page. Visitors notice nothing, and there is no image to decipher."
msgstr ""

#: includes/class-settings-registry.php:719
msgid "Community threat check on forms"
msgstr ""

#: includes/class-settings-registry.php:720
msgid "Ask the community network about the visitor address when a comment, sign-up or password reset is submitted, using the same protection level the sign-in page enforces. Needs Community Network mode."
msgstr ""

#: includes/class-settings-registry.php:727
msgid "Disposable email domains on forms and comments"
msgstr ""

#: includes/class-settings-registry.php:728
msgid "What happens when a comment or a protected contact form carries an address from a throwaway mail provider. A refused sender is asked at the form for a permanent address."
msgstr ""

#: includes/class-settings-registry.php:735
msgid "Action on a comment scored as spam"
msgstr ""

#: includes/class-settings-registry.php:736
msgid "Whether a comment that trips several spam signals is filed as spam, rejected outright, or left to WordPress."
msgstr ""

#: includes/class-settings-registry.php:742
msgid "Decoy path blocking"
msgstr ""

#: includes/class-settings-registry.php:743
msgid "Serve bait paths that only a scanner would ask for, and report whoever takes the bait to the community."
msgstr ""

#: includes/class-settings-registry.php:752
msgid "Hide login enabled"
msgstr ""

#: includes/class-settings-registry.php:753
msgid "Move the sign-in page away from wp-login.php, so the address that every bot tries first leads nowhere."
msgstr ""

#: includes/class-settings-registry.php:762
msgid "Login slug"
msgstr ""

#: includes/class-settings-registry.php:763
msgid "The path your sign-in page lives at. Note it somewhere before saving, because the old address stops working immediately."
msgstr ""

#: includes/class-settings-registry.php:770
msgid "Response on the default login URL"
msgstr ""

#: includes/class-settings-registry.php:771
msgid "What a visitor to the old sign-in address sees. A plain 404 gives away less than a block page."
msgstr ""

#: includes/class-settings-registry.php:777
msgid "Monitor login probe attempts"
msgstr ""

#: includes/class-settings-registry.php:778
msgid "Count who keeps knocking at the old sign-in address. Nobody does that by accident."
msgstr ""

#: includes/class-settings-registry.php:786
msgid "Login probe threshold"
msgstr ""

#: includes/class-settings-registry.php:787
msgid "How many probes at the old address one visitor may make inside the window below."
msgstr ""

#: includes/class-settings-registry.php:795
msgid "Login probe window (minutes)"
msgstr ""

#: includes/class-settings-registry.php:796
msgid "The window probes are counted in."
msgstr ""

#: includes/class-settings-registry.php:802
msgid "Append the login token to generated URLs"
msgstr ""

#: includes/class-settings-registry.php:803
msgid "Append the login token to links WordPress generates. Convenient for password-reset mails, but it also puts the hidden path into anything that logs a URL."
msgstr ""

#: includes/class-settings-registry.php:811
msgid "REST API access"
msgstr ""

#: includes/class-settings-registry.php:812
msgid "Who may use the REST API. Many plugins and the block editor depend on it, so try a restriction before you rely on it."
msgstr ""

#: includes/class-settings-registry.php:818
msgid "REST namespaces always allowed"
msgstr ""

#: includes/class-settings-registry.php:819
msgid "Namespaces that stay reachable whatever the mode above says, one per line. This is where a cookie banner or a shop plugin goes."
msgstr ""

#: includes/class-settings-registry.php:829
msgid "Roles allowed to use the REST API"
msgstr ""

#: includes/class-settings-registry.php:830
msgid "The roles that may use the REST API while access is restricted to roles."
msgstr ""

#: includes/class-settings-registry.php:836
msgid "Disable XML-RPC"
msgstr ""

#: includes/class-settings-registry.php:837
msgid "Switch off xmlrpc.php and pingbacks completely. Most sites never use it; the Jetpack app and some publishing tools do. If you need XML-RPC, leave this off and use the multicall switch below instead."
msgstr ""

#: includes/class-settings-registry.php:843
msgid "Disable RSS and Atom feeds"
msgstr ""

#: includes/class-settings-registry.php:844
msgid "Return a 404 for RSS and Atom feeds. Turn this on only if nothing subscribes to your site."
msgstr ""

#: includes/class-settings-registry.php:850
msgid "Close wp-admin for visitors"
msgstr ""

#: includes/class-settings-registry.php:851
msgid "Send signed-out visitors away from wp-admin instead of showing them the sign-in form."
msgstr ""

#: includes/class-settings-registry.php:857
msgid "Block PHP execution in uploads"
msgstr ""

#: includes/class-settings-registry.php:858
msgid "Refuse to run PHP inside the uploads folder, so a file that got in through an upload form cannot be executed. Written into the uploads .htaccess on Apache; other servers get a snippet to paste."
msgstr ""

#: includes/class-settings-registry.php:864
msgid "Hide software fingerprints"
msgstr ""

#: includes/class-settings-registry.php:865
msgid "Remove the version numbers WordPress prints into your pages. It does not fix anything, it just stops handing a scanner the list of what to try."
msgstr ""

#: includes/class-settings-registry.php:871
msgid "Send security headers"
msgstr ""

#: includes/class-settings-registry.php:872
msgid "Send hardening response headers on every front-end request. A header your server already sets is left alone."
msgstr ""

#: includes/class-settings-registry.php:878
msgid "X-Content-Type-Options"
msgstr ""

#: includes/class-settings-registry.php:879
msgid "Stop the browser from guessing a file type against what you declared, which is how an uploaded image gets treated as a script."
msgstr ""

#: includes/class-settings-registry.php:887
msgid "X-Frame-Options"
msgstr ""

#: includes/class-settings-registry.php:888
msgid "Who may put your pages inside a frame. Same-origin is right for almost every site; deny breaks legitimate embeds."
msgstr ""

#: includes/class-settings-registry.php:895
msgid "Referrer-Policy"
msgstr ""

#: includes/class-settings-registry.php:896
msgid "How much of the current address is passed on when a visitor follows a link away from your site."
msgstr ""

#: includes/class-settings-registry.php:903
msgid "HTTP Strict Transport Security"
msgstr ""

#: includes/class-settings-registry.php:904
msgid "Tell the browser to reach this site over HTTPS only, from now on. Never turn this on before HTTPS works everywhere, because it cannot be taken back quickly."
msgstr ""

#: includes/class-settings-registry.php:913
msgid "HSTS max-age (seconds)"
msgstr ""

#: includes/class-settings-registry.php:914
msgid "How long the browser remembers the HTTPS-only instruction. Start short while you are testing."
msgstr ""

#: includes/class-settings-registry.php:921
msgid "HSTS includeSubDomains"
msgstr ""

#: includes/class-settings-registry.php:922
msgid "Apply the HTTPS-only instruction to every subdomain as well. Check that all of them really have a certificate first."
msgstr ""

#: includes/class-settings-registry.php:929
msgid "HSTS preload"
msgstr ""

#: includes/class-settings-registry.php:930
msgid "Ask to be added to the browsers' built-in HTTPS-only list. Getting off that list takes months, so only set it when the setup is final."
msgstr ""

#: includes/class-settings-registry.php:938
msgid "Permissions-Policy"
msgstr ""

#: includes/class-settings-registry.php:939
msgid "Which browser features your pages are allowed to use. The default switches off camera, microphone, location and payment, which almost no site needs."
msgstr ""

#: includes/class-settings-registry.php:948
msgid "Content-Security-Policy mode"
msgstr ""

#: includes/class-settings-registry.php:949
msgid "Whether the content policy is enforced or only reported. Always run it in report-only first; an enforced policy that is too strict makes a page look broken."
msgstr ""

#: includes/class-settings-registry.php:956
msgid "Content-Security-Policy"
msgstr ""

#: includes/class-settings-registry.php:957
msgid "The policy itself. It decides which scripts, styles and frames may load, and it is the one header that will break your theme if it is wrong."
msgstr ""

#: includes/class-settings-registry.php:964
msgid "CSP report URI"
msgstr ""

#: includes/class-settings-registry.php:965
msgid "Where the browser sends policy violations while you are tuning the policy."
msgstr ""

#: includes/class-settings-registry.php:974
msgid "Cross-Origin-Opener-Policy"
msgstr ""

#: includes/class-settings-registry.php:975
msgid "Separate your pages from windows they opened, so a foreign page cannot reach back into yours."
msgstr ""

#: includes/class-settings-registry.php:984
msgid "Cross-Origin-Resource-Policy"
msgstr ""

#: includes/class-settings-registry.php:985
msgid "Who may embed your resources such as images and scripts."
msgstr ""

#: includes/class-settings-registry.php:994
msgid "Cross-Origin-Embedder-Policy"
msgstr ""

#: includes/class-settings-registry.php:995
msgid "Require every embedded resource to opt in. Needed for some browser features, and it breaks third-party embeds that have not opted in."
msgstr ""

#: includes/class-settings-registry.php:1003
msgid "Two-factor authentication enabled"
msgstr ""

#: includes/class-settings-registry.php:1004
msgid "Master switch for the second factor. Off, nobody is asked for one, whatever the roles below say."
msgstr ""

#: includes/class-settings-registry.php:1013
msgid "Allowed 2FA methods"
msgstr ""

#: includes/class-settings-registry.php:1014
msgid "The methods users may set up. Leave at least one that works without a phone, or a lost device locks the account out."
msgstr ""

#: includes/class-settings-registry.php:1020
msgid "Subject of the e-mail code"
msgstr ""

#: includes/class-settings-registry.php:1021
msgid "Subject line of the mail that carries the sign-in code. Leave empty for the default; {site_name} is replaced with the site title."
msgstr ""

#: includes/class-settings-registry.php:1030
msgid "Roles required to use 2FA"
msgstr ""

#: includes/class-settings-registry.php:1031
msgid "Roles that must use a second factor. Everyone else may, and is asked to."
msgstr ""

#: includes/class-settings-registry.php:1039
msgid "2FA grace period (days)"
msgstr ""

#: includes/class-settings-registry.php:1040
msgid "How long a required user may keep signing in before setting the second factor up."
msgstr ""

#: includes/class-settings-registry.php:1048
msgid "Maximum onboarding skips"
msgstr ""

#: includes/class-settings-registry.php:1049
msgid "How often a required user may postpone the setup during the grace period."
msgstr ""

#: includes/class-settings-registry.php:1056
msgid "Action when grace period is exhausted"
msgstr ""

#: includes/class-settings-registry.php:1057
msgid "What happens to a required user who never set the second factor up."
msgstr ""

#: includes/class-settings-registry.php:1064
msgid "Let users mark a device so they are not asked for the code on every sign-in."
msgstr ""

#: includes/class-settings-registry.php:1070
msgid "Enforce 2FA for super admins"
msgstr ""

#: includes/class-settings-registry.php:1071
msgid "Also require the second factor from network super admins. They are the most valuable account on a multisite, and the easiest to forget."
msgstr ""

#: includes/class-settings-registry.php:1077
msgid "Extend the trusted-device window on \"remember me\""
msgstr ""

#: includes/class-settings-registry.php:1078
msgid "Give the trusted-device cookie a longer life when the user ticked \"remember me\". More convenient, and a stolen laptop stays signed in longer."
msgstr ""

#: includes/class-settings-registry.php:1085
msgid "IP addresses exempt from the second factor"
msgstr ""

#: includes/class-settings-registry.php:1086
msgid "Addresses or ranges that skip the second factor, one per line. This is a way past your own 2FA policy, so keep it to networks you control."
msgstr ""

#: includes/class-settings-registry.php:1092
msgid "Brand the login challenge"
msgstr ""

#: includes/class-settings-registry.php:1093
msgid "Show your site name and logo on the challenge page instead of the plain WordPress one."
msgstr ""

#: includes/class-settings-registry.php:1099
msgid "Mail the user when a new device signs in"
msgstr ""

#: includes/class-settings-registry.php:1100
msgid "Mail the user when their account is used from a device it has not seen before."
msgstr ""

#: includes/class-settings-registry.php:1106
msgid "Remind users without a second factor"
msgstr ""

#: includes/class-settings-registry.php:1107
msgid "Show a banner after sign-in to users who have not set up a second factor yet. Roles listed below are locked out once they ignore it too often."
msgstr ""

#: includes/class-settings-registry.php:1115
msgid "Sign-ins before the reminder locks out"
msgstr ""

#: includes/class-settings-registry.php:1116
msgid "How many sign-ins without a second factor a user in one of the roles below gets before the reminder turns into a hard stop."
msgstr ""

#: includes/class-settings-registry.php:1124
msgid "Roles the reminder locks out"
msgstr ""

#: includes/class-settings-registry.php:1125
msgid "Roles that cannot keep signing in without a second factor once the count above is reached. An empty list falls back to administrators, editors and shop managers."
msgstr ""

#: includes/class-settings-registry.php:1131
msgid "XML-RPC accepts application passwords only"
msgstr ""

#: includes/class-settings-registry.php:1132
msgid "Refuse account passwords over XML-RPC and accept application passwords only, so XML-RPC stops being a way around the second factor."
msgstr ""

#: includes/class-settings-registry.php:1138
msgid "Block a password reset when e-mail is the only second factor"
msgstr ""

#: includes/class-settings-registry.php:1139
msgid "Refuse a password reset for users whose only second factor is e-mail. Otherwise a stolen mailbox is enough for both steps."
msgstr ""

#: includes/class-settings-registry.php:1147
msgid "Trusted device lifetime (days)"
msgstr ""

#: includes/class-settings-registry.php:1148
msgid "How long a trusted device stays trusted before the code is asked for again."
msgstr ""

#: includes/class-settings-registry.php:1154
msgid "Require 2FA on password reset"
msgstr ""

#: includes/class-settings-registry.php:1155
msgid "Ask for the second factor during a password reset, so a hijacked mailbox is not enough on its own."
msgstr ""

#: includes/class-settings-registry.php:1161
msgid "Password policy"
msgstr ""

#: includes/class-settings-registry.php:1162
msgid "Check new passwords against the rules below before accepting them."
msgstr ""

#: includes/class-settings-registry.php:1170
msgid "Minimum password length"
msgstr ""

#: includes/class-settings-registry.php:1171
msgid "The shortest password that is accepted. Length helps more than any other single rule."
msgstr ""

#: includes/class-settings-registry.php:1179
msgid "Required character classes"
msgstr ""

#: includes/class-settings-registry.php:1180
msgid "How many of upper case, lower case, digits and symbols a password must mix."
msgstr ""

#: includes/class-settings-registry.php:1186
msgid "Apply the password policy to every role"
msgstr ""

#: includes/class-settings-registry.php:1187
msgid "Apply the rules to every role rather than to the ones that can change the site."
msgstr ""

#: includes/class-settings-registry.php:1193
msgid "Check passwords against known breaches"
msgstr ""

#: includes/class-settings-registry.php:1194
msgid "Reject passwords that appear in known breach lists. Only the first five characters of a hash leave the site, never the password."
msgstr ""

#: includes/class-settings-registry.php:1202
msgid "Log level"
msgstr ""

#: includes/class-settings-registry.php:1203
msgid "How much detail lands in the security log."
msgstr ""

#: includes/class-settings-registry.php:1210
msgid "Minimal logging"
msgstr ""

#: includes/class-settings-registry.php:1211
msgid "Record only what is needed to make a decision, and leave out everything that would identify a person."
msgstr ""

#: includes/class-settings-registry.php:1217
msgid "Log user agents"
msgstr ""

#: includes/class-settings-registry.php:1218
msgid "Record the browser identification with each security event and audit trail entry. Useful for telling a bot from a customer, and it is personal data."
msgstr ""

#: includes/class-settings-registry.php:1227
msgid "Data retention (days)"
msgstr ""

#: includes/class-settings-registry.php:1228
msgid "How long security events are kept before they are deleted."
msgstr ""

#: includes/class-settings-registry.php:1236
msgid "Auto-anonymize after (days)"
msgstr ""

#: includes/class-settings-registry.php:1237
msgid "How long before addresses in old events are shortened. Keeps the statistics while dropping the identifying part."
msgstr ""

#: includes/class-settings-registry.php:1243
msgid "Record request details with each event"
msgstr ""

#: includes/class-settings-registry.php:1244
msgid "Record the request context with each event. Helps when reconstructing an incident, and makes the log bigger."
msgstr ""

#: includes/class-settings-registry.php:1250
msgid "Record the referring domain"
msgstr ""

#: includes/class-settings-registry.php:1251
msgid "Record which site a visitor came from."
msgstr ""

#: includes/class-settings-registry.php:1257
msgid "Cache community lookups"
msgstr ""

#: includes/class-settings-registry.php:1258
msgid "Remember community answers instead of asking again for the same address. This is what keeps the check off your response time."
msgstr ""

#: includes/class-settings-registry.php:1266
msgid "Cache lifetime (hours)"
msgstr ""

#: includes/class-settings-registry.php:1267
msgid "How long a community answer is reused."
msgstr ""

#: includes/class-settings-registry.php:1275
msgid "Clean-result cache lifetime (hours)"
msgstr ""

#: includes/class-settings-registry.php:1276
msgid "How long a clean result is reused. Shorter than the above, because an address can turn bad quickly."
msgstr ""

#: includes/class-settings-registry.php:1284
msgid "Community lookups per hour (0 = no local limit)"
msgstr ""

#: includes/class-settings-registry.php:1285
msgid "A local ceiling on community lookups per hour. Zero means only your plan quota applies."
msgstr ""

#: includes/class-settings-registry.php:1293
msgid "Report cooldown per address (hours)"
msgstr ""

#: includes/class-settings-registry.php:1294
msgid "How long to wait before reporting the same address again, so one persistent attacker does not eat the daily report budget."
msgstr ""

#: includes/class-settings-registry.php:1302
msgid "Discard queued reports after (days)"
msgstr ""

#: includes/class-settings-registry.php:1303
msgid "How long a report may sit in the queue before it is dropped as stale."
msgstr ""

#: includes/class-settings-registry.php:1311
msgid "Queue warning threshold"
msgstr ""

#: includes/class-settings-registry.php:1312
msgid "The queue length at which the status page starts warning."
msgstr ""

#: includes/class-settings-registry.php:1320
msgid "Queue critical threshold"
msgstr ""

#: includes/class-settings-registry.php:1321
msgid "The queue length at which the status page calls it critical."
msgstr ""

#: includes/class-settings-registry.php:1329
msgid "Recover stuck queue rows after (minutes)"
msgstr ""

#: includes/class-settings-registry.php:1330
msgid "How long a report may stay in processing before it is assumed the worker crashed and the row is picked up again."
msgstr ""

#: includes/class-settings-registry.php:1337
msgid "Show the protection badge in the site footer"
msgstr ""

#: includes/class-settings-registry.php:1338
msgid "Show a small protection badge in your site footer."
msgstr ""

#: includes/class-settings-registry.php:1346
msgid "Footer badge style"
msgstr ""

#: includes/class-settings-registry.php:1347
msgid "Which badge is shown."
msgstr ""

#: includes/class-settings-registry.php:1354
msgid "Footer badge placement"
msgstr ""

#: includes/class-settings-registry.php:1355
msgid "Where the badge sits in the footer."
msgstr ""

#: includes/class-settings-registry.php:1361
msgid "Send notification preferences to the community server"
msgstr ""

#: includes/class-settings-registry.php:1362
msgid "Let the community server know your notification preferences, so it can reach you about your account."
msgstr ""

#: includes/class-settings-registry.php:1370
msgid "Per-event notification cap (minutes)"
msgstr ""

#: includes/class-settings-registry.php:1371
msgid "How long to wait before mailing about the same kind of event again."
msgstr ""

#: includes/class-settings-registry.php:1379
msgid "Admin notifications"
msgstr ""

#: includes/class-settings-registry.php:1380
msgid "Mail the recipients below when something needs a person to look at it."
msgstr ""

#: includes/class-settings-registry.php:1387
msgid "Notification recipients"
msgstr ""

#: includes/class-settings-registry.php:1388
msgid "Who receives those mails. Several addresses can be separated by commas."
msgstr ""

#: includes/class-settings-registry.php:1394
msgid "Sender name"
msgstr ""

#: includes/class-settings-registry.php:1395
msgid "The sender name on mails this plugin sends."
msgstr ""

#: includes/class-settings-registry.php:1401
msgid "Sender address"
msgstr ""

#: includes/class-settings-registry.php:1402
msgid "The sender address. Use one at your own domain, otherwise the mails land in spam."
msgstr ""

#: includes/class-settings-registry.php:1410
msgid "Notification cooldown (minutes)"
msgstr ""

#: includes/class-settings-registry.php:1411
msgid "How long the same address and event type stays quiet after a mail went out."
msgstr ""

#: includes/class-settings-registry.php:1417
msgid "Show upgrade hints in the admin"
msgstr ""

#: includes/class-settings-registry.php:1418
msgid "Off hides every plan promotion in wp-admin: dashboard cards, inline hints and the WooCommerce banner. Security notices are not affected."
msgstr ""

#: includes/class-settings-registry.php:1424
msgid "Mail when the relay quota reaches 80 % or 100 %"
