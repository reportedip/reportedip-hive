#: admin/class-admin-settings.php:4859
msgid "Watch failed logins"
msgstr ""

#: admin/class-admin-settings.php:4865
msgid "How many wrong passwords?"
msgstr ""

#: admin/class-admin-settings.php:4867
msgid "Trigger after this many failed attempts from one IP. 5 is a good starting point."
msgstr ""

#: admin/class-admin-settings.php:4870
#: admin/class-admin-settings.php:4884
#: admin/class-admin-settings.php:4912
#: admin/class-admin-settings.php:4945
#: admin/class-admin-settings.php:4980
#: admin/class-admin-settings.php:5007
#: admin/class-admin-settings.php:5043
#: admin/class-admin-settings.php:5079
#: admin/class-admin-settings.php:5578
msgid "Within how many minutes?"
msgstr ""

#: admin/class-admin-settings.php:4872
msgid "Counters reset after this window. Shorter = stricter, but more sensitive to legitimate users mistyping their password."
msgstr ""

#: admin/class-admin-settings.php:4876
msgid "Password-spray detection"
msgstr ""

#: admin/class-admin-settings.php:4877
msgid "Triggers when one IP tries many different usernames quickly — a stronger signal than the per-IP attempt count above."
msgstr ""

#: admin/class-admin-settings.php:4880
msgid "How many distinct usernames?"
msgstr ""

#: admin/class-admin-settings.php:4893
#: admin/class-admin-settings.php:8415
msgid "Comment spam"
