msgstr "Serveur détecté"

#: admin/class-admin-firewall.php:418 templates/two-factor-onboarding.php:137
msgid "Setup"
msgstr "Configuration"

#: admin/class-admin-firewall.php:418
msgid "Automatic"
msgstr "Automatique"

#: admin/class-admin-firewall.php:418
msgid "Manual, one line"
msgstr "Manuel, une ligne"

#: admin/class-admin-firewall.php:419
msgid "Guard file"
msgstr "Fichier du garde"

#: admin/class-admin-firewall.php:419
