msgstr "Bitte warte %d Sekunden, bevor du einen neuen Code anforderst."

#. translators: %s: site name
#: includes/class-two-factor-email.php:121
#, php-format
msgid "[%s] Your verification code"
msgstr "[%s] Dein Bestätigungscode"

#: includes/class-two-factor-email.php:139
msgid "Use the code below to finish signing in to your account. The code is good for one sign-in only."
msgstr "Verwende den folgenden Code, um die Anmeldung an deinem Konto abzuschließen. Der Code ist nur für eine einzige Anmeldung gültig."

#. translators: 1: verification code, 2: minutes valid
#: includes/class-two-factor-email.php:143
#, php-format
msgid "Your verification code: %1$s (valid for %2$d minutes)"
msgstr "Dein Bestätigungscode: %1$s (gültig für %2$d Minuten)"

#: includes/class-two-factor-email.php:151
msgid "Never share this code with anyone. Our team will never ask you for it."
msgstr "Gib diesen Code niemals an jemanden weiter. Unser Team wird dich niemals danach fragen."

#: includes/class-two-factor-email.php:161
msgid "Could not send email."
msgstr "E-Mail konnte nicht gesendet werden."

#: includes/class-two-factor-email.php:321
