#, php-format
msgid "Value must be one of: %s"
msgstr "Der Wert muss einer der folgenden sein: %s"

#: includes/class-settings-registry.php:1459
msgid "Unknown value kind."
msgstr "Unbekannter Wertetyp."

#: includes/class-settings-registry.php:1481
msgid "Hide Login cannot be enabled without a login slug, set a slug first."
msgstr "Hide Login kann nicht ohne Login-Slug aktiviert werden, bitte zuerst einen Slug festlegen."

#: includes/class-settings-registry.php:1784
msgid "Value must be a JSON array of strings."
msgstr "Der Wert muss ein JSON-Array aus Zeichenketten sein."

